{
  "name": "joomla-ws-api",
  "private": true,
  "description": "OpenAPI specification of the Joomla core Web Services API",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "format": "node scripts/format.mjs",
    "format:check": "node scripts/format.mjs --check",
    "validate:schema": "node scripts/validate-schema.mjs src/joomla-ws-api.json",
    "lint": "redocly lint src/joomla-ws-api.json --format=stylish",
    "quality": "node scripts/check-quality.mjs src/joomla-ws-api.json",
    "routes": "node scripts/check-routes.mjs src/joomla-ws-api.json",
    "check": "npm run format:check && npm run validate:schema && npm run lint && npm run quality",
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@redocly/cli": "2.72.1",
    "@seriousme/openapi-schema-validator": "2.11.0"
  }
}
